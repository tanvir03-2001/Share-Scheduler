# Frontend Environment Variables
# API URL - Backend server URL for API calls
# For development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# For production (Vercel), set this to your backend Vercel URL:
# NEXT_PUBLIC_API_URL=https://your-backend-app.vercel.app/api

# Facebook Business App Configuration (Client Side)
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-business-app-id-here
NEXT_PUBLIC_FACEBOOK_API_VERSION=v18.0
